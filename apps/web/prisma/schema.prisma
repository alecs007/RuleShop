// RuleShop — Prisma schema.
//  - Strict multi-tenancy: every business entity carries `storeId`, and
//    uniqueness is compound, so two stores can share a SKU, slug or email.
//  - Rules are structured JSON data, never executable code.
//  - Rule lifecycle: Rule (working draft) -> RuleVersion (immutable snapshot)
//    -> RuleSet.activeVersion / canaryVersion.
//  - Money is stored in minor units.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OPERATOR
  STORE_ADMIN
  PLATFORM_ADMIN
}

enum OrderStatus {
  PENDING
  AWAITING_REVIEW
  PAID
  FULFILLED
  CANCELLED
  REJECTED
  REFUNDED
}

/// The decision points the rule engine controls.
enum DecisionCategory {
  PRICING
  SHIPPING
  FRAUD
  AVAILABILITY
  LOYALTY
  THEME
}

/// How conflicts between matching rules are resolved, per ruleset.
enum ConflictStrategy {
  PRIORITY_FIRST_MATCH
  PRIORITY_ALL_MATCHES
  MOST_SPECIFIC
  BEST_FOR_CUSTOMER
}

enum RuleStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum RuleVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ROLLED_BACK
  ARCHIVED
}

/// The channel a version was published on.
enum PublishChannel {
  STABLE
  CANARY
}

/// Where a rule or version came from, for AI suggestion traceability.
enum AuthoringSource {
  HUMAN
  AI_SUGGESTION
  IMPORT
  SEED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// The fraud decision applied at checkout.
enum FraudDecision {
  ALLOW
  CHALLENGE
  REVIEW
  BLOCK
}

enum FraudReviewStatus {
  OPEN
  CONFIRMED_FRAUD
  FALSE_POSITIVE
  DISMISSED
}

/// Nothing is published automatically: an accepted suggestion becomes a DRAFT
/// rule at most, published by hand.
enum AiSuggestionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  /// Output that failed the application's validation.
  INVALID
}

/// What a suggestion proposes, which decides what accepting it does.
enum AiSuggestionKind {
  NEW_RULE
  MODIFY_RULE
  DISABLE_RULE
  /// An observation with no applicable action.
  INFO
}

enum AuditAction {
  RULE_CREATED
  RULE_UPDATED
  RULE_DELETED
  RULE_ENABLED
  RULE_DISABLED
  RULESET_CREATED
  RULESET_UPDATED
  VERSION_CREATED
  VERSION_PUBLISHED
  VERSION_CANARY_PUBLISHED
  VERSION_ROLLED_BACK
  KILL_SWITCH_ON
  KILL_SWITCH_OFF
  AI_SUGGESTION_GENERATED
  AI_SUGGESTION_APPROVED
  AI_SUGGESTION_REJECTED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  ORDER_STATUS_CHANGED
  ORDER_BLOCKED
  USER_ROLE_CHANGED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  STORE_SETTINGS_UPDATED
  STORE_CREATED
  STORE_ACTIVATED
  STORE_DEACTIVATED
  STORE_DEFAULT_CHANGED
  FRAUD_INCIDENT_REVIEWED
}

/// An independent store: the root of data isolation. Nothing from one store
/// may be reachable from another.
model Store {
  id       String  @id @default(cuid()) @map("_id")
  slug     String  @unique
  name     String
  /// Uniqueness is enforced in the application: on MongoDB a unique index on
  /// an optional field collides across multiple nulls.
  domain   String?
  currency String  @default("RON")
  locale   String  @default("ro-RO")
  active   Boolean @default(true)
  /// The path prefix the store is served under: "de" means /de/... `null` is
  /// the main store, served at the root, and at most one store may have it —
  /// enforced by `setMainStore`, for the MongoDB reason above. The prefix
  /// cannot be a reserved segment, or it would shadow the app's routes.
  pathPrefix String?

  /// The default theme. THEME rules override it at runtime, without a deploy.
  themeDefaults Json @default("{}")
  /// General store settings: shipping methods, VAT, contact details.
  settings      Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  products       Product[]
  carts          Cart[]
  orders         Order[]
  ruleSets       RuleSet[]
  rules          Rule[]
  ruleVersions   RuleVersion[]
  auditLogs      AuditLog[]
  fraudIncidents FraudIncident[]
  evaluationEvents EvaluationEvent[]
  aiSuggestions    AiSuggestion[]

  @@index([active])
  @@map("stores")
}

/// Customer identity is platform-wide; belonging to a store comes from carts
/// and orders. `storeId` is set only for store staff, never for a
/// PLATFORM_ADMIN.
model User {
  id           String  @id @default(cuid()) @map("_id")
  storeId      String?
  email        String  @unique
  name         String?
  image        String?
  /// Staff password sign-in only.
  passwordHash String?
  role         Role    @default(CUSTOMER)
  active       Boolean @default(true)

  emailVerified DateTime?
  lastLoginAt   DateTime?

  // Signals the rules read: loyalty, segmentation, fraud.
  loyaltyTier    String @default("STANDARD")
  loyaltyPoints  Int    @default(0)
  lifetimeSpend  Int    @default(0) // in bani/cents
  completedOrders Int   @default(0)
  /// Free-form attributes exposed to the evaluation context.
  attributes     Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store           Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  accounts        Account[]
  sessions        Session[]
  carts           Cart[]
  orders          Order[]
  createdRules    Rule[]          @relation("RuleAuthor")
  createdVersions RuleVersion[]   @relation("VersionAuthor")
  publishedVersions RuleVersion[] @relation("VersionPublisher")
  auditLogs       AuditLog[]
  fraudIncidents  FraudIncident[] @relation("FraudSubject")
  reviewedIncidents FraudIncident[] @relation("FraudReviewer")

  @@index([storeId, role])
  @@map("users")
}

/// An OAuth account linked to a user (Auth.js).
model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Only used with the "database" session strategy; the adapter requires the
/// model even though we use JWTs.
model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Product {
  id          String  @id @default(cuid()) @map("_id")
  storeId     String
  sku         String
  slug        String
  name        String
  description String  @default("")
  category    String
  brand       String?

  /// The base price. The final one is always the PRICING ruleset's verdict
  /// over this value.
  basePriceCents Int
  currency       String   @default("RON")
  stock          Int      @default(0)
  /// Stock held by orders in flight.
  reservedStock  Int      @default(0)
  weightGrams    Int      @default(0)
  tags           String[] @default([])
  imageUrls      String[] @default([])
  active         Boolean  @default(true)

  /// Arbitrary attributes exposed to the rule engine.
  attributes Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([storeId, sku])
  @@unique([storeId, slug])
  @@index([storeId, active, category])
  @@index([storeId, name])
  @@map("products")
}

/// A persistent cart, identified by `sessionKey` so it works the same for
/// guests and signed-in customers; `userId` is attached at sign-in.
model Cart {
  id         String  @id @default(cuid()) @map("_id")
  storeId    String
  sessionKey String
  userId     String?

  /// The customer's chosen shipping method. A preference only: if a rule
  /// removes it, the quote falls back to the cheapest available one.
  shippingMethodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@unique([storeId, sessionKey])
  @@index([storeId, userId])
  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid()) @map("_id")
  cartId    String
  productId String
  quantity  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id          String @id @default(cuid()) @map("_id")
  storeId     String
  orderNumber String

  // Either a signed-in purchase or a guest one.
  userId     String?
  guestEmail String?
  guestName  String?
  /// The stable session id used for deterministic canary assignment when
  /// there is no signed-in user.
  sessionKey String

  status OrderStatus @default(PENDING)

  subtotalCents Int
  discountCents Int    @default(0)
  shippingCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int
  currency      String @default("RON")

  shippingMethod  String?
  shippingAddress Json    @default("{}")
  billingAddress  Json    @default("{}")
  paymentMethod   String?
  /// Payment is simulated; only the reference and the outcome are kept.
  paymentRef      String?

  /// A snapshot of the final decisions: price, shipping, fraud, loyalty.
  decisionSnapshot Json    @default("{}")
  /// The rules that reached the final decision.
  matchedRuleKeys  String[] @default([])
  /// The ruleset versions used, per category: { "PRICING": 7, ... }
  rulesetVersions  Json     @default("{}")
  traceId          String?
  /// Which branch, canary or stable, this session landed on.
  canaryCohort     Boolean  @default(false)

  loyaltyPointsEarned Int @default(0)
  loyaltyPointsSpent  Int @default(0)
  riskScore           Int @default(0)

  placedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  fraudIncidents FraudIncident[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([storeId, userId])
  @@index([storeId, guestEmail])
  @@index([traceId])
  @@map("orders")
}

/// An order line, holding a snapshot of the product and the pricing decision,
/// so history stays accurate when the product changes.
model OrderItem {
  id        String  @id @default(cuid()) @map("_id")
  orderId   String
  productId String?

  sku         String
  name        String
  quantity    Int
  /// The base price at order time, before rules.
  basePriceCents  Int
  /// The unit price after the PRICING rules.
  finalPriceCents Int
  discountCents   Int @default(0)
  lineTotalCents  Int

  /// The rules that changed this line, with their explanation.
  appliedRules Json @default("[]")

  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// A store's rules for one decision point, together with its publishing
/// state: the stable and canary versions, the canary share and the kill
/// switch.
model RuleSet {
  id          String           @id @default(cuid()) @map("_id")
  storeId     String
  key         String
  name        String
  description String           @default("")
  category    DecisionCategory

  conflictStrategy ConflictStrategy @default(PRIORITY_FIRST_MATCH)
  /// The fail-safe decision, returned when nothing matches or the kill switch
  /// is on.
  defaultDecision  Json             @default("{}")

  /// These pointers are one-to-many at the schema level, with no unique index:
  /// on MongoDB such an index on an optional field collides across nulls, so
  /// the second unpublished ruleset would be rejected. The publishing service
  /// guarantees the real uniqueness.
  activeVersionId  String?
  canaryVersionId  String?
  /// The share of traffic sent to the canary version, 0-100.
  canaryPercentage Int     @default(0)
  /// Stops the whole category at once, falling back to `defaultDecision`.
  killSwitch       Boolean @default(false)
  killSwitchReason String?
  killSwitchAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rules         Rule[]
  versions      RuleVersion[] @relation("RuleSetVersions")
  // NoAction: relations are emulated on MongoDB, so the RuleSet <-> RuleVersion
  // cycle has to be broken; the publishing service does the repointing.
  activeVersion RuleVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  canaryVersion RuleVersion?  @relation("CanaryVersion", fields: [canaryVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([storeId, key])
  @@unique([storeId, category])
  @@index([storeId, killSwitch])
  @@map("rule_sets")
}

/// The working draft of a rule. Conditions and actions are JSON structures
/// validated by the application, never executable code.
///
/// conditions: { "type": "group", "op": "AND" | "OR" | "NOT", "children": [
///                 { "type": "condition", "fact": "cart.total",
///                   "operator": "gte", "value": 20000 } ] }
/// actions:    [ { "type": "SET_DISCOUNT_PERCENT", "params": { "value": 15 } } ]
model Rule {
  id          String @id @default(cuid()) @map("_id")
  storeId     String
  ruleSetId   String
  key         String
  name        String
  description String @default("")

  /// Higher value wins.
  priority Int        @default(100)
  status   RuleStatus @default(DRAFT)
  enabled  Boolean    @default(true)

  conditions Json
  actions    Json
  /// Free-form metadata: owner, ticket, rationale, test notes.
  metadata   Json     @default("{}")
  tags       String[] @default([])

  /// The validity window, for time-limited campaigns.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  source          AuthoringSource @default(HUMAN)
  /// The AI module's plain-language explanation, when there is one.
  aiRationale     String?
  aiConfidence    Float?
  createdById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ruleSet   RuleSet  @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("RuleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([ruleSetId, key])
  @@index([storeId, ruleSetId, status])
  @@index([ruleSetId, priority])
  @@map("rules")
}

/// An immutable snapshot of a ruleset at publish time. The engine evaluates
/// nothing else, which is why a rollback is just a repointing of
/// `RuleSet.activeVersionId`.
model RuleVersion {
  id        String @id @default(cuid()) @map("_id")
  storeId   String
  ruleSetId String
  version   Int

  status         RuleVersionStatus @default(DRAFT)
  publishChannel PublishChannel?
  /// The canary share this version was published with.
  canaryPercentage Int             @default(0)

  /// The frozen content: { conflictStrategy, defaultDecision, rules: [...] }.
  snapshot      Json
  /// A structured diff against the previous version.
  diff          Json    @default("{}")
  changeSummary String  @default("")
  /// Hash of the snapshot, for detecting no-op publishes.
  checksum      String

  source AuthoringSource @default(HUMAN)
  /// The simulation over historical events, computed by the application.
  simulationMetrics Json @default("{}")

  createdById   String?
  publishedById String?
  publishedAt   DateTime?
  rolledBackAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ruleSet     RuleSet  @relation("RuleSetVersions", fields: [ruleSetId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("VersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User?    @relation("VersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  /// Lists only because of the MongoDB constraint described in RuleSet: in
  /// practice a version is active or canary for at most one ruleset.
  activeFor RuleSet[] @relation("ActiveVersion")
  canaryFor RuleSet[] @relation("CanaryVersion")

  @@unique([ruleSetId, version])
  @@index([storeId, ruleSetId, status])
  @@index([ruleSetId, publishedAt])
  @@map("rule_versions")
}

/// The audit log for the important operations.
model AuditLog {
  id      String  @id @default(cuid()) @map("_id")
  /// Null for platform-level actions.
  storeId String?

  action     AuditAction
  entityType String
  entityId   String?

  actorId    String?
  actorEmail String?
  actorRole  Role?

  /// Before and after, so the change can be reconstructed.
  before   Json    @default("{}")
  after    Json    @default("{}")
  metadata Json    @default("{}")

  ipAddress String?
  userAgent String?
  /// Links the entry to an engine evaluation.
  traceId   String?

  createdAt DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, action, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// A real engine evaluation with its full fact context. It backs the browsable
/// decision history and the simulation of candidate versions, where the
/// application re-evaluates the stored contexts and computes the metrics
/// itself. Writes are rate limited, and the context holds no customer email.
model EvaluationEvent {
  id      String           @id @default(cuid()) @map("_id")
  storeId String
  category DecisionCategory

  rulesetVersion  Int
  traceId         String?
  matchedRuleKeys String[] @default([])
  /// The evaluation's final decision.
  decision Json @default("{}")
  /// The fact context the engine ran on: enough to re-evaluate.
  context  Json
  usedDefault Boolean @default(false)
  /// Where the event came from: product-page | checkout | cart.
  source String @default("shop")

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, category, createdAt])
  @@index([traceId])
  @@map("evaluation_events")
}

/// A suggestion the AI module made about a ruleset, with everything audit
/// needs: the model, the prompt version, the input digest, the statistics it
/// leaned on and the raw response. The flow is PROPOSED -> a human accepts or
/// rejects; accepting yields a DRAFT rule and publishing stays manual.
model AiSuggestion {
  id      String           @id @default(cuid()) @map("_id")
  storeId String
  category DecisionCategory

  kind   AiSuggestionKind
  status AiSuggestionStatus @default(PROPOSED)

  title          String
  explanation    String
  /// The estimated business impact, marked as an estimate.
  businessImpact String @default("")
  confidence     Float

  /// The existing rules targeted, for MODIFY and DISABLE.
  ruleKeys     String[] @default([])
  /// The proposed rule, for NEW_RULE and MODIFY_RULE.
  proposedRule Json?
  /// What the application's validation found; empty means valid.
  validationIssues Json @default("[]")

  model         String
  promptVersion Int    @default(1)
  /// SHA-256 of the input, tying the suggestion to the exact data.
  inputDigest   String
  /// The application-computed statistics the analysis leaned on.
  usageStats    Json   @default("{}")
  rawResponse   Json?
  /// Groups the suggestions from a single analysis run.
  analysisRunId String?

  createdById   String?
  decidedById   String?
  decidedAt     DateTime?
  /// The DRAFT rule created or edited on acceptance.
  appliedRuleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, category, status, createdAt])
  @@index([analysisRunId])
  @@map("ai_suggestions")
}

/// An incident the FRAUD ruleset raised at checkout, and the data set the AI
/// classification works from.
model FraudIncident {
  id      String  @id @default(cuid()) @map("_id")
  storeId String
  orderId String?
  userId  String?

  sessionKey String
  email      String?
  ipAddress  String?
  userAgent  String?
  /// The device fingerprint, when available.
  fingerprint String?

  riskScore Int
  riskLevel RiskLevel
  decision  FraudDecision

  /// The signals that raised it: order velocity, IP country, address
  /// mismatch, an unusual cart.
  signals         Json     @default("{}")
  matchedRuleKeys String[] @default([])
  rulesetVersion  Int?
  traceId         String?
  /// The decision's explanation, as the UI shows it.
  explanation     Json     @default("{}")

  aiClassification String?
  aiConfidence     Float?
  aiRationale      String?

  reviewStatus FraudReviewStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order      Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user       User?  @relation("FraudSubject", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User?  @relation("FraudReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, reviewStatus, riskLevel])
  @@index([storeId, sessionKey])
  @@index([traceId])
  @@map("fraud_incidents")
}
