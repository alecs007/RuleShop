# MongoDB (Prisma cere replica set pentru tranzactii — docker-compose.yml il porneste deja configurat)
DATABASE_URL="mongodb://localhost:27017/ruleshop?replicaSet=rs0&directConnection=true"

# Redis — limitare de rata. Fara el, limitarea ramane in memoria procesului.
REDIS_URL="redis://localhost:6379"

# Override de dezvoltare pentru magazinul servit clientilor. In mod normal lasa-l
# comentat: magazinul activ se alege din panou (Magazine -> „Fa-l activ"), iar
# valoarea de aici are prioritate si ar face butonul fara efect.
# DEFAULT_STORE_SLUG="ruleshop-ro"

# NextAuth
AUTH_SECRET="genereaza-cu: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# Obligatoriu in spatele unui reverse proxy (Railway, Render, Fly): fara el,
# Auth.js refuza sa construiasca adresele de callback si login-ul eșuează.
AUTH_TRUST_HOST="true"

# OAuth — autentificarea clientilor se face exclusiv prin Google si Facebook.
# Google:   https://console.cloud.google.com/apis/credentials
#           redirect URI: http://localhost:3000/api/auth/callback/google
# Facebook: https://developers.facebook.com/apps
#           redirect URI: http://localhost:3000/api/auth/callback/facebook
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Stocarea imaginilor de produs — bucket S3-compatibil (MinIO local din
# docker-compose.yml; aceleasi variabile merg pe S3, R2 sau Spaces).
# Consola MinIO: http://localhost:9001
# Fara S3_BUCKET / chei, aplicatia cade automat pe disc local (UPLOAD_DIR),
# ca incarcarea de imagini sa functioneze si fara container de storage.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="ruleshop-media"
S3_ACCESS_KEY_ID="ruleshop"
S3_SECRET_ACCESS_KEY="ruleshop-secret"
S3_REGION="us-east-1"
# MinIO cere path-style; pe S3 real pune "false"
S3_FORCE_PATH_STYLE="true"
# Folderul driverului de rezerva (in afara `public/`, servit prin /api/v1/media)
UPLOAD_DIR="storage/uploads"

# Modulul IA — Google Gemini (analiza regulilor, generare din limbaj natural,
# clasificare antifrauda). Fara cheie, platforma merge normal, dar functiile IA
# sunt dezactivate (interfata explica).
# Cheie: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional; implicit "gemini-flash-latest" (alias care nu expira). Modelele cu
# versiune fixa pot da 404 cand Google le retrage pentru cheile noi.
GEMINI_MODEL=""

# Serverul MCP propriu (mcp/server.mjs) vorbeste cu API-ul /api/v1/ai folosind
# acest token de serviciu. Genereaza ceva lung si aleator (openssl rand -hex 32).
MCP_API_TOKEN=""
